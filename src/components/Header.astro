---
import Logo from './Logo.astro';
import { nav } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(href);
---

<header class="header">
  <nav class="container bar" aria-label="Principal">
    <a href="/" class="home" aria-label="SERAC, inicio"><Logo /></a>
    <button class="toggle" type="button" aria-expanded="false" aria-controls="menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <span>Menú</span>
    </button>
    <ul id="menu" class="menu">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li><a href="/#contacto" class="btn btn-primary cta">Reservar cupo</a></li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.header .toggle');
  const menu = document.getElementById('menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('open', !open);
  });
  const close = (returnFocus = false) => {
    if (toggle?.getAttribute('aria-expanded') !== 'true') return;
    toggle.setAttribute('aria-expanded', 'false');
    menu?.classList.remove('open');
    if (returnFocus) toggle.focus();
  };
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) close();
  });
  // Escape cierra el menú y devuelve el foco al botón.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close(true);
  });
  // Al pasar a escritorio, el menú desplegable no debe quedar abierto.
  matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
    if (e.matches) close();
  });
</script>

<style>
  .header {
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
  .home {
    color: var(--ink);
    text-decoration: none;
  }
  .menu {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) 28px;
    font-size: 14px;
    font-weight: 500;
  }
  .link {
    display: inline-block;
    color: var(--ink);
    text-decoration: none;
    padding-block: 12px;
    border-bottom: 2px solid transparent;
  }
  .link:hover,
  .link[aria-current='page'] {
    color: var(--link);
  }
  .link[aria-current='page'] {
    border-bottom-color: var(--link);
  }
  .cta {
    min-height: 44px;
    padding: 10px 20px;
  }
  .toggle {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 8px 12px;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .toggle {
      display: inline-flex;
    }
    .menu {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-bottom: var(--space-4);
    }
    .menu.open {
      display: flex;
    }
    .menu li + li {
      border-top: 1px solid var(--line);
    }
    .link {
      display: block;
      font-size: 16px;
      padding-block: 14px;
      border-bottom: 0;
    }
    .cta {
      margin-top: var(--space-4);
      width: 100%;
    }
  }
</style>
