---
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';

interface Props {
  entry: CollectionEntry<'expediciones'>;
}
const { entry } = Astro.props;
const d = entry.data;
const soon = d.status === 'proximamente';
---

<article class="card exp">
  <Photo label={d.photo} />
  <div class="body">
    <div class="chips">
      <span class="chip">{d.country}</span>
      <span class="chip">{d.kind}</span>
    </div>
    <h3 class="heading-2">{d.title}</h3>
    <dl class="facts">
      <div><dt>{d.altitudeLabel}</dt><dd>{d.altitude}</dd></div>
      <div><dt>Duración</dt><dd>{d.days}</dd></div>
      <div><dt>Nivel</dt><dd>{d.level}</dd></div>
    </dl>
    <p class="muted meta">Salida: {d.departure} · Cupos: {d.spots}</p>
    <div class="foot">
      <span class="price">USD {d.price}</span>
      {
        soon ? (
          <a href="/#contacto" class="btn btn-secondary">Avísame</a>
        ) : (
          <a href={`/expediciones/${entry.id}/`} class="btn btn-primary" aria-label={`Ver ruta: ${d.title}`}>
            Ver ruta
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .exp {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex-grow: 1;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    font-size: 14px;
  }
  .facts dt {
    color: var(--ink-muted);
    font-size: 12px;
  }
  .facts dd {
    font-weight: 600;
  }
  .meta {
    font-size: 14px;
  }
  .foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .foot .btn {
    min-height: 44px;
    padding: 10px 18px;
    font-size: 14px;
  }
  .price {
    font-weight: 600;
  }
</style>
