---
// Fotografía con marcador mientras no haya imagen real.
// `src` acepta una imagen importada desde src/assets (optimizada con astro:assets: WebP, tamaños, dimensiones)
// o una URL. `priority` es para la imagen principal de la página (carga inmediata, sin lazy).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  label: string;
  src?: ImageMetadata | string;
  alt?: string;
  height?: string;
  radius?: 'none' | 'md' | 'lg';
  priority?: boolean;
  class?: string;
}
const { label, src, alt = label, height = '220px', radius = 'none', priority = false, class: className } = Astro.props;
const r = { none: '0', md: 'var(--radius-md)', lg: 'var(--radius-lg)' }[radius];
const style = `height:${height};border-radius:${r}`;
const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : undefined;
---

{
  typeof src === 'object' ? (
    <Image class:list={['photo', className]} src={src} alt={alt} style={style} widths={[480, 960, 1440, 1920]} sizes="(max-width: 1200px) 100vw, 1200px" loading={loading} fetchpriority={fetchpriority} />
  ) : src ? (
    <img class:list={['photo', className]} src={src} alt={alt} style={style} loading={loading} fetchpriority={fetchpriority} decoding="async" />
  ) : (
    <div class:list={['photo', 'placeholder', className]} style={style} role="img" aria-label={`Foto pendiente: ${label}`}>
      <span>[FOTO: {label}]</span>
    </div>
  )
}

<style>
  .photo {
    width: 100%;
    object-fit: cover;
  }
  .placeholder {
    background: var(--placeholder);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    text-align: center;
    font-size: 12px;
    color: var(--ink-muted);
  }
</style>
